{
  "rules": {
    "locations": {
      "$groupId": {
        ".read": "auth != null",
        "$uid": {
          ".read": "auth != null",
          ".write": "auth.uid === $uid",
          ".validate": "newData.hasChildren(['uid','name','lat','lng','online','updatedAt'])",
          "lat":       {".validate": "newData.isNumber() && newData.val() >= -90  && newData.val() <= 90"},
          "lng":       {".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"},
          "online":    {".validate": "newData.isBoolean()"},
          "name":      {".validate": "newData.isString() && newData.val().length <= 100"},
          "uid":       {".validate": "newData.isString() && newData.val() === auth.uid"},
          "avatar":    {".validate": "newData.isString()"},
          "accuracy":  {".validate": "newData.isNumber()"},
          "address":   {".validate": "newData.isString()"},
          "updatedAt": {".validate": "newData.isNumber()"}
        }
      }
    },
    "$other": {".read": false, ".write": false}
  }
}
